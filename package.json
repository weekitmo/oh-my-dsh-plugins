{
  "name": "oh-my-dsh-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Personal DeepSeek Harness plugin collection.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm -r --if-present run check && pnpm run check:installer",
    "check:installer": "sh -n install.sh && ./install.sh all --dry-run",
    "clean": "node scripts/clean.mjs",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  }
}
