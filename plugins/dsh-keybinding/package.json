{
  "name": "@weekit/dsh-keybinding",
  "version": "0.1.1",
  "description": "DSH Web keyboard shortcut manager with an integrated local terminal",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./core": {
      "types": "./lib/core.d.mts",
      "default": "./lib/core.mjs"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "bundle": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weekitmo/oh-my-dsh-plugins.git",
    "directory": "plugins/dsh-keybinding"
  },
  "bugs": {
    "url": "https://github.com/weekitmo/oh-my-dsh-plugins/issues"
  },
  "homepage": "https://github.com/weekitmo/oh-my-dsh-plugins/tree/main/plugins/dsh-keybinding#readme",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fontkit": "^2.0.4",
    "node-pty": "^1.2.0-beta.15",
    "react": "^18.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "jsdom": "^26.0.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
