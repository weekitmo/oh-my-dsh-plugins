{
  "name": "@weekit/dsh-notify",
  "version": "0.3.1",
  "description": "Unified desktop, browser-title, and sidebar completion notifications for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weekitmo/oh-my-dsh-plugins.git",
    "directory": "plugins/dsh-notify"
  },
  "bugs": {
    "url": "https://github.com/weekitmo/oh-my-dsh-plugins/issues"
  },
  "homepage": "https://github.com/weekitmo/oh-my-dsh-plugins/tree/main/plugins/dsh-notify#readme",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notification",
    "desktop-notification",
    "browser-notification",
    "task-notification",
    "web-ui",
    "typescript"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-api-session-controller": "*",
    "@deepseek-ai/dsh-client-store": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-session-title": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-jobs": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-registry": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.27.0",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
